# ==============================================================================
# GlamGo Luxury Beauty Marketplace — Production Environment Template
# ==============================================================================
# IMPORTANT: DO NOT commit actual secrets to version control.
# Copy this file to .env.production on the target production host and inject secrets
# via a secure secrets manager (AWS Secrets Manager, HashiCorp Vault, GCP Secret Manager).
# ==============================================================================

# Application Environment (enforces security headers, disables Swagger/Redoc, enforces >=32 char secret key)
ENVIRONMENT=production
PROJECT_NAME="GlamGo Premium Beauty Marketplace"
ENABLE_DOCS=false

# Security & JWT Tokens
# Minimum 32 cryptographically random characters (e.g., generated with `openssl rand -hex 32`)
SECRET_KEY=replace_with_a_cryptographically_secure_32_char_secret_key_minimum!
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Configuration (PostgreSQL 16)
# Note: In production Docker Compose, database host is 'db' (isolated bridge network).
POSTGRES_USER=glamgo_prod_admin
POSTGRES_PASSWORD=replace_with_strong_random_db_password_minimum_16_chars!
POSTGRES_DB=glamgo_prod_db
DATABASE_URL=postgresql+psycopg://glamgo_prod_admin:replace_with_strong_random_db_password_minimum_16_chars!@db:5432/glamgo_prod_db

# Cache & Lock Cluster (Redis 7)
# Note: In production Docker Compose, redis host is 'redis' (isolated bridge network).
REDIS_URL=redis://redis:6379/0

# Payment Gateway (Razorpay Live Production Credentials)
# Obtain these from the Razorpay Merchant Dashboard -> Settings -> API Keys & Webhooks.
RAZORPAY_KEY_ID=rzp_live_replace_with_actual_key_id
RAZORPAY_KEY_SECRET=replace_with_actual_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_actual_webhook_signing_secret

# Logging & Correlation
LOG_LEVEL=INFO
