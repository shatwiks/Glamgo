# ==============================================================================
# GlamGo Luxury Beauty Marketplace — Staging Environment Template
# ==============================================================================

ENVIRONMENT=staging
PROJECT_NAME="GlamGo Beauty Marketplace (Staging)"
ENABLE_DOCS=true

SECRET_KEY=glamgo_staging_jwt_secret_key_minimum_32_chars_2026!
ACCESS_TOKEN_EXPIRE_MINUTES=60

POSTGRES_USER=glamgo_staging
POSTGRES_PASSWORD=glamgo_staging_secure_password
POSTGRES_DB=glamgo_staging_db
DATABASE_URL=postgresql+psycopg://glamgo_staging:glamgo_staging_secure_password@db:5432/glamgo_staging_db

REDIS_URL=redis://redis:6379/0

# Razorpay Test / Sandbox Credentials
RAZORPAY_KEY_ID=rzp_test_example_key_id
RAZORPAY_KEY_SECRET=example_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=example_webhook_secret_placeholder

LOG_LEVEL=DEBUG
