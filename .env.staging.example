# ==============================================================================
# GlamGo Luxury Beauty Marketplace — Staging Environment Template
# ==============================================================================
# Nonfunctional placeholder template. Inject real staging secrets via environment.

ENVIRONMENT=staging
PROJECT_NAME="GlamGo Beauty Marketplace (Staging)"
ENABLE_DOCS=true

SECRET_KEY=replace_with_staging_secret_key_minimum_32_characters
ACCESS_TOKEN_EXPIRE_MINUTES=60

POSTGRES_USER=replace_with_staging_db_user
POSTGRES_PASSWORD=replace_with_staging_db_password
POSTGRES_DB=glamgo_staging_db
DATABASE_URL=postgresql+psycopg://replace_with_staging_db_user:replace_with_staging_db_password@db:5432/glamgo_staging_db

REDIS_URL=redis://redis:6379/0
REDIS_REQUIRED=true

# Razorpay Test / Sandbox Credentials
RAZORPAY_KEY_ID=rzp_test_replace_with_sandbox_key_id
RAZORPAY_KEY_SECRET=replace_with_sandbox_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_sandbox_webhook_secret

# Internal Maintenance Service Authentication
INTERNAL_MAINTENANCE_TOKEN=replace_with_32_char_maintenance_service_token

LOG_LEVEL=DEBUG
